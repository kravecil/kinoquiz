{
  "name": "kinoquiz",
  "version": "0.1.0",
  "private": true,
  "description": "КиноКвиз — угадай фильм по описанию. Браузерная игра для Яндекс Игр.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "build:standalone": "npm run check && vite build --mode standalone",
    "pack": "npm run build && npm run zip",
    "zip": "node tools/pack.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && node tools/validate-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "node tools/validate-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/poiret-one": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/ysdk": "^1.2.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
